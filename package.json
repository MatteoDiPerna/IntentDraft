{
  "name": "intentdraft",
  "private": true,
  "description": "IntentDraft monorepo — frontend + backend",
  "scripts": {
    "dev:all": "concurrently -n fe,be -c blue,green \"npm run dev --prefix frontend\" \"npm run dev --prefix backend\"",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:restart": "pm2 restart intentdraft-api intentdraft-web",
    "pm2:restart:api": "pm2 restart intentdraft-api",
    "pm2:restart:web": "pm2 restart intentdraft-web",
    "pm2:stop": "pm2 stop intentdraft-api intentdraft-web",
    "pm2:delete": "pm2 delete intentdraft-api intentdraft-web",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pm2": "^6.0.14"
  }
}
