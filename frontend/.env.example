# Backend API (fase 2). Con mock attivo l'app non chiama il server.
VITE_API_URL=http://localhost:3001
VITE_USE_MOCK=true

# OAuth Google (redirect browser verso backend)
VITE_GOOGLE_AUTH_START_URL=http://localhost:3001/api/auth/google

# Limiti UI
VITE_MAX_MESSAGE_CHARS=12000
VITE_MAX_UPLOAD_BYTES=5242880
